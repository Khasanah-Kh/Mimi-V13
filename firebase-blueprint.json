{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a learner profile, educational tier, XP, streak, and preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the authenticated user."
        },
        "displayName": {
          "type": "string",
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "photoUrl": {
          "type": "string",
          "description": "User avatar URL."
        },
        "selectedEducationLevel": {
          "type": "string",
          "description": "Selected schooling stage (SD, SMP, SMA, SMK, UMUM, CURHAT)."
        },
        "selectedClass": {
          "type": "string",
          "description": "Selected grade class."
        },
        "streakDays": {
          "type": "integer",
          "description": "Current learning daily streak count."
        },
        "totalXp": {
          "type": "integer",
          "description": "Total experience points accumulated."
        },
        "progressCurrent": {
          "type": "integer",
          "description": "Current level progress index."
        },
        "progressTotal": {
          "type": "integer",
          "description": "Total level progress target."
        },
        "completedLevels": {
          "type": "array",
          "description": "List of completed level indices or titles."
        },
        "completedQuizzes": {
          "type": "integer",
          "description": "Total number of completed quizzes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["userId", "displayName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles and persistent study state."
    }
  }
}
